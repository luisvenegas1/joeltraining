# ── Supabase (frontend) ──────────────────────────────────────────
# La clave ANON/publishable es segura para el frontend: la seguridad real
# depende de Supabase Auth + RLS, NO de ocultar esta clave.
# NUNCA pongas la service_role key aquí ni en el frontend.
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=tu_clave_anon_publishable

# ── Autenticación y multi-tenant (flags del corte) ──────────────
# Login: legacy (usuario/contraseña, como hoy) o supabase (Supabase Auth).
VITE_AUTH_MODE=legacy
# Resolver el tenant por hostname/slug (on tras migraciones + Auth).
VITE_MULTITENANT=off
# En local no hay subdominios; se resuelve el tenant por ruta (/joheltraining).
# Este valor solo fuerza un tenant por defecto en dev si lo necesitás.
VITE_DEFAULT_TENANT_SLUG=
# Persistir users.avatar_url (poner on SOLO después de aplicar la migración 0013).
VITE_AVATAR_URL_ENABLED=off

# ── Solo backend / scripts admin (NUNCA en el frontend ni en commits) ──
# Se usan en la Edge Function / script de administración, fuera del navegador.
# SUPABASE_SERVICE_ROLE_KEY=...   (NO commitear un valor real)
